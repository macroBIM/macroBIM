# 완성된 영상은 리포지토리에 두지 않습니다.
#
# 바이너리는 델타 압축이 안 되므로 다시 인코딩할 때마다 17 MB 짜리 새 블롭이
# 히스토리에 영원히 남습니다. 타워 영상 두 번 커밋에 34 MB 가 들었고, 그 시점에
# Pages 가 배포하던 44 MB 중 38 MB 가 동영상이었습니다 — 엔진·예제·문서를 다 합친
# 나머지가 6 MB 인데 말이죠.
#
# 배포 채널은 YouTube 이고, 여기 있는 도구가 명령 몇 줄로 영상을 다시 만듭니다.
# 그래서 절차는: 완성본을 파일로 보내 → 받으신 것을 확인 → 지워도 되는지 여쭙고
# → 지운다.
*.mp4

# Build products of the shoot. Everything here is regenerated by tools/, and
# the generators are what is worth keeping - a hundred near-identical workbooks
# and a few thousand JPEGs are not.
src/
norm/
seq/
node_modules
# 60 books six degrees apart - tools/make_crane_files.js writes them in seconds
slew/
tools/node_modules
tools/src/
tools/src2/
tools/src6/
tools/src_backup/
tools/norm/
tools/seq/
# cards and the sheet page: tools/mkcards_tower.js, tools/mkparampage.js
tools/t_*.html
tools/t_*.png
tools/shots.json
tools/shots_recovered.json
tools/filter.txt
tools/shoot.log
tools/v_font.css
# preview crops pulled out of the film while checking a beat
tools/crop_*.jpg
tools/seq_*.jpg
tools/preview_*.jpg
# staging stills pulled while checking a beat
tools/pv_*.jpg
tools/ph_*.jpg
tools/pv_hoist.js

# splice film: same rule, its own names. The generators are tools/mkcards_splice.js,
# tools/mkcellcards_splice.js, tools/prep_splice.js and tools/shoot_splice.js.
tools/src_splice/
tools/splice/
tools/shots_splice.json
tools/shoot_splice.log

# splice film build products
tools/norm_splice/
tools/seq_splice/
tools/filter_splice.txt

# Run logs of every pass, named one at a time until now. A shoot or an encode
# writes one each time it runs and none of them is worth keeping - the tool that
# produced the log is what is worth keeping.
tools/*.log

# teaching film: same rule, its own names. The generators are tools/mkcards_basic.js,
# tools/rendercards_basic.js and tools/make_basic_cases.js.
tools/basic/
tools/src_basic/
tools/norm_basic/
tools/seq_basic/
tools/shots_basic.json
tools/shoot_basic.log
tools/filter_basic.txt
tools/.case_boq.xlsx

# thumbnail intermediates - the hero grabs, the pages and the 2x renders.
# mkthumb.js redraws all of them; the finished 1280x720 jpg is what is kept.
tools/thumb_*.html
tools/thumb_*.png

# Basics 03 (BAR & SECT): same rule, its own names. Generators are
# tools/mkcards_barsect.js, tools/mksheets_barsect.js, tools/make_barsect_cases.js,
# tools/shoot_barsect.js and tools/assemble_barsect.js.
tools/barsect/
tools/src_barsect/
tools/norm_barsect/
tools/seq_barsect/
tools/shots_barsect.json
tools/shoot_barsect.log
tools/filter_barsect.txt
tools/.bs_boq.xlsx

# Probe workbooks. probe_tube.js / probe_scale.js write them in seconds; the
# question they answer is in the scripts, not in the files.
tools/probe/

# Probe workbooks. probe_tube.js / probe_scale.js write them in seconds; the
# question they answer is in the scripts, not in the files.
tools/probe/
